# Copy to .env and adjust. Real environment variables override this file.
# Values are read at process start; restart the service after editing.

# --- HTTP ---
GRIDTRADE_HOST=127.0.0.1
GRIDTRADE_PORT=8000
# Access token. If omitted, a random one is generated in var/token.
GRIDTRADE_TOKEN=
GRIDTRADE_DATA=research/data
GRIDTRADE_VAR=var
GRIDTRADE_WEB=web/dist
GRIDTRADE_SYMBOL=GOOGLUSDT
GRIDTRADE_AUTORUN=1
GRIDTRADE_SECURE_COOKIE=0

# --- Paper trading (real-time grid, public futures feed) ---
# source: gate (api.gateio.ws USDT perpetuals; reachable from CN/HK cloud)
GRIDTRADE_PAPER_ENABLED=1
GRIDTRADE_PAPER_AUTOSTART=1
GRIDTRADE_PAPER_SOURCE=gate
GRIDTRADE_PAPER_SYMBOL=GOOGL_USDT
GRIDTRADE_PAPER_CAPITAL=10000
GRIDTRADE_PAPER_LEVERAGE=2
GRIDTRADE_PAPER_SPACING_BP=60
GRIDTRADE_PAPER_LEVELS=20
GRIDTRADE_PAPER_STOP_DD_PCT=10
GRIDTRADE_PAPER_MAKER_FEE_BP=2
GRIDTRADE_PAPER_TAKER_FEE_BP=5
GRIDTRADE_PAPER_POLL_SECONDS=3
