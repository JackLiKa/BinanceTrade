# Copy to .env and adjust. Real environment variables override this file.
# Values are read at process start; restart the service after editing.

# --- HTTP ---
GRIDTRADE_HOST=127.0.0.1
GRIDTRADE_PORT=8000
# Access token. If omitted, a random one is generated in var/token.
GRIDTRADE_TOKEN=
GRIDTRADE_DATA=research/data
GRIDTRADE_VAR=var
GRIDTRADE_WEB=web/dist
GRIDTRADE_SYMBOL=GOOGLUSDT
GRIDTRADE_AUTORUN=1
# 实时行情源（Binance 公共接口）。服务器出网被墙时设为 0，避免每次请求等待超时。
GRIDTRADE_MARKET_LIVE=1
# 访问 Binance 的代理（HTTP/HTTPS CONNECT 或 socks5://，后者需 pip install socksio）
GRIDTRADE_PROXY=
# Google OAuth：广州服务器经东京节点中继访问 Google（见 scripts/tokyo_google_relay.py）
GRIDTRADE_GOOGLE_RELAY=
GRIDTRADE_GOOGLE_RELAY_TOKEN=
GRIDTRADE_PUBLIC_URL=https://gt.jacklika.com
GRIDTRADE_SECURE_COOKIE=0

# --- Paper trading (real-time grid, public futures feed) ---
# source: gate (api.gateio.ws USDT perpetuals; reachable from CN/HK cloud)
GRIDTRADE_PAPER_ENABLED=1
GRIDTRADE_PAPER_AUTOSTART=1
GRIDTRADE_PAPER_SOURCE=gate
GRIDTRADE_PAPER_SYMBOLS=SKHY_USDT,SPCX_USDT,GOOGL_USDT,AMGN_USDT
GRIDTRADE_PAPER_CAPITAL=10000
GRIDTRADE_PAPER_LEVERAGE=2
GRIDTRADE_PAPER_SPACING_BP=60
GRIDTRADE_PAPER_LEVELS=20
GRIDTRADE_PAPER_STOP_DD_PCT=10
GRIDTRADE_PAPER_MAKER_FEE_BP=2
GRIDTRADE_PAPER_TAKER_FEE_BP=5
# 优先使用合约公开的 maker/taker 费率，关闭则用上面的固定 bp
GRIDTRADE_PAPER_USE_EXCHANGE_FEES=1
GRIDTRADE_PAPER_POLL_SECONDS=3

# --- Binance execution node (read-only) ---------------------------------
GRIDTRADE_BINANCE_NODE_URL=
# 模拟盘行情源：binance（经东京节点）或 gate（旧兼容）
GRIDTRADE_PAPER_SOURCE=binance

# TradingWorkstation tw.jacklika.com 登录网关
GRIDTRADE_TW_PUBLIC_URL=https://tw.jacklika.com
GRIDTRADE_TW_ALLOWED_EMAILS=040418jie@gmail.com,jacklika.business@gmail.com
